# OpenAlex key: optional for ordinary metadata discovery, required for cached-content acquisition.
# Passed only in the authorization header.
RESEARCH_ATLAS_OPENALEX_API_KEY=

# Optional real contact address for Crossref polite access; no default email.
RESEARCH_ATLAS_CROSSREF_MAILTO=

# Set locally/in the process environment; never commit real database credentials.
# PostgreSQL with Psycopg: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
RESEARCH_ATLAS_DATABASE_URL=

# Explicit opt-in to PostgreSQL acceptance tests and test-targeted migrations.
# Use a dedicated test database, never your runtime database.
RESEARCH_ATLAS_TEST_DATABASE_URL=

# Extraction is opt-in. No provider or model default.
# Native: openai, anthropic, gemini, kimi, openrouter, deepseek, ollama.
# Generic strict Chat Completions endpoint: openai_compatible.
RESEARCH_ATLAS_EXTRACTION_PROVIDER=
RESEARCH_ATLAS_EXTRACTION_MODEL=
# Optional native endpoint override; required for openai_compatible.
# Include the API prefix (such as /v1); the adapter appends its operation path.
# Credentials never belong in this URL. See docs/providers.md for native defaults.
RESEARCH_ATLAS_EXTRACTION_BASE_URL=
# Provider-specific runtime secrets; only the selected native provider needs its key.
# Never commit real keys. Use environment variables or an untracked local .env.
RESEARCH_ATLAS_OPENAI_API_KEY=
RESEARCH_ATLAS_ANTHROPIC_API_KEY=
RESEARCH_ATLAS_GEMINI_API_KEY=
RESEARCH_ATLAS_KIMI_API_KEY=
RESEARCH_ATLAS_OPENROUTER_API_KEY=
RESEARCH_ATLAS_DEEPSEEK_API_KEY=
# Optional when the compatible endpoint has no authentication (e.g. local vLLM).
RESEARCH_ATLAS_OPENAI_COMPATIBLE_API_KEY=
# Backward-compatible OpenAI fallback; optional Ollama bearer key and compatible fallback.
# This generic key is NOT used by Anthropic, Gemini, Kimi, OpenRouter or DeepSeek.
RESEARCH_ATLAS_EXTRACTION_API_KEY=
RESEARCH_ATLAS_EXTRACTION_TIMEOUT_SECONDS=600
# Anthropic requires a bounded output token budget; no model is selected by this setting.
RESEARCH_ATLAS_EXTRACTION_MAX_OUTPUT_TOKENS=8192
