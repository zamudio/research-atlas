# Required by Atlas for OpenAlex cached content. Get a key at https://openalex.org/settings/api.
# Set these in your environment (Atlas does not load .env files automatically).
RESEARCH_ATLAS_OPENALEX_API_KEY=

# Optional per-request deadline in seconds, default 20; must be > 0 and <= 120.
RESEARCH_ATLAS_HTTP_TIMEOUT_SECONDS=20
