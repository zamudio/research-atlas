# Optional for small discovery requests; OpenAlex and Semantic Scholar can run keyless.
RESEARCH_ATLAS_OPENALEX_API_KEY=
RESEARCH_ATLAS_SEMANTIC_SCHOLAR_API_KEY=

# Optional real contact address for experimental Crossref polite access; no default email.
RESEARCH_ATLAS_CROSSREF_MAILTO=

# Required only when constructing the read-only Zotero adapter.
RESEARCH_ATLAS_ZOTERO_LIBRARY_ID=
RESEARCH_ATLAS_ZOTERO_LIBRARY_TYPE=user
RESEARCH_ATLAS_ZOTERO_API_KEY=
