# OpenAlex key: optional for ordinary metadata discovery, required for cached-content acquisition.
# Passed only in the authorization header.
RESEARCH_ATLAS_OPENALEX_API_KEY=

# Optional real contact address for Crossref polite access; no default email.
RESEARCH_ATLAS_CROSSREF_MAILTO=

# Set locally/in the process environment; never commit real database credentials.
# PostgreSQL with Psycopg: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
RESEARCH_ATLAS_DATABASE_URL=

# Explicit opt-in to PostgreSQL acceptance tests and test-targeted migrations.
# Use a dedicated test database, never your runtime database.
RESEARCH_ATLAS_TEST_DATABASE_URL=
