# OpenAlex key: required for cached GROBID XML; sent only in the authorization header.
RESEARCH_ATLAS_OPENALEX_API_KEY=

# Explicit model selection: ollama, openai, anthropic, gemini, kimi, openrouter,
# deepseek, or openai_compatible. Neither provider nor model has a default.
RESEARCH_ATLAS_MODEL_PROVIDER=
RESEARCH_ATLAS_MODEL_NAME=

# Optional native override; required for openai_compatible. Include any /v1 prefix.
RESEARCH_ATLAS_MODEL_BASE_URL=
# Only the selected provider needs credentials.
RESEARCH_ATLAS_OPENAI_API_KEY=
RESEARCH_ATLAS_ANTHROPIC_API_KEY=
RESEARCH_ATLAS_GEMINI_API_KEY=
RESEARCH_ATLAS_KIMI_API_KEY=
RESEARCH_ATLAS_OPENROUTER_API_KEY=
RESEARCH_ATLAS_DEEPSEEK_API_KEY=
RESEARCH_ATLAS_OPENAI_COMPATIBLE_API_KEY=

# Optional Ollama bearer key.
RESEARCH_ATLAS_OLLAMA_API_KEY=
RESEARCH_ATLAS_MODEL_TIMEOUT_SECONDS=600

# Anthropic output token budget.
RESEARCH_ATLAS_MODEL_MAX_OUTPUT_TOKENS=8192